---
import { useTranslations } from '../i18n/utils';
import { about } from '../i18n/content';
import type { Lang } from '../i18n/ui';

const lang = Astro.currentLocale as Lang ?? 'en';
const t = useTranslations(lang);
---

<section id='about' class='min-h-dvh relative z-10'>
    <div class='w-full max-w-6xl mx-auto mt-[140px]'>
        <h2 class='has-dots items-start mb-0 w-fit'>{t('about.title')}</h2>
        <div class='flex-col !text-sm justify-center items-center w-full md:w-1/2 md:ml-auto'>
        <p class='bubble !block !max-w-none w-full px-4 whitespace-pre-line'>
        {about[lang]}
        </p>
        <img src="/about.webp" alt="" class='w-64 h-auto object-cover'>
        </div>
    </div>
</section>
