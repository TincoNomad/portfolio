---
import SocialIcon from './SocialIcon.astro';
---

<footer class="w-full bg-black text-(--color-cream)">
    <div class="w-full max-w-6xl mx-auto px-[clamp(1rem,3vw,2rem)] py-4 md:py-8">
        <div class="flex flex-col items-center gap-8 sm:flex-row sm:justify-between">
            <div class="flex flex-col items-center gap-4 md:flex-row">
                <div class="footer-image-fade">
                  <img src='/yo_fogata.png' alt='Renzo Tincopa' class='hero-image aspect-square object-cover'>
                </div>
                <div class="btn-wrap">
                    <div class="shadow"></div>
                    <button class="face footer-cta px-[clamp(0.5rem,1.5vw,0.75rem)]! py-[clamp(0.25rem,0.8vw,0.375rem)]!" type="button" data-contact>Let's build together</button>
                </div>
            </div>
            <div class="flex flex-col gap-4 items-center">
                <ul class='gap-6 min-[769px]:gap-16'>
                    <li>
                        <a href="#about" class="text-(--color-cream) hover:underline">About</a>
                    </li>
                    <li>
                        <a href="#" class="text-(--color-cream) hover:underline">Privacy Policy</a>
                    </li>
                    <li>
                        <a href="#" class="text-(--color-cream) hover:underline" data-contact>Contact</a>
                    </li>
                </ul>
                <ul class='socials-grid gap-4'>
                    <li><SocialIcon name='github' url='https://github.com/TincoNomad' class='badge' size={28} /></li>
                    <li><SocialIcon name='linkedin' url='https://www.linkedin.com/in/tinconomad/' class='badge' size={28} /></li>
                    <li><SocialIcon name='instagram' url='https://www.instagram.com/tinconomad/' class='badge instagram' size={28} /></li>
                    <li><SocialIcon name='bluesky' url='https://bsky.app/profile/wiracocha-labs.bsky.social' class='badge' size={28} /></li>
                    <li><SocialIcon name='mastodon' url='https://mastodon.social/@TincoNomad' class='badge' size={28} /></li>
                    <li><SocialIcon name='tiktok' url='https://www.tiktok.com/@tinconomad' class='badge' size={28} /></li>
                </ul>
            </div>
        </div>
        <hr class="my-6 border-default sm:mx-auto lg:my-8" />
        <span class="block text-sm text-body text-center">© 2026 <a href="https://flowbite.com/" class="hover:underline">Renzo Tincopa</a>. Done with love from Inka's sacret valley, Urumaba, Cusco. Peru 🇵🇪.</span>
    </div>
</footer>


