---
import SocialIcon from './SocialIcon.astro';
---

<section class='min-h-dvh scroll-mt-20 relative' id='home'>
    <div class='grid md:grid-cols-2 items-center w-full md:max-w-6xl md:mx-auto mb-30 gap-8 relative z-10'>
        <div class='flex flex-col items-start gap-4 md:col-start-2 md:row-start-1'>
            <h1 class='has-dots'>Renzo Tincopa</h1>
            <h2>Backend Blacksmith</h2>
            <h2 class='bubble bubble-shadow-right mb-8 max-w-[clamp(254px,36.43vw,437px)]! text-[clamp(1.125rem,2.59vw,1.29rem)]!'>You tell me what you're trying to achieve.<br/>I design the system and build it</h2>
            <div class='flex flex-wrap gap-4'>
                <div class='btn-wrap'>
                    <div class='shadow'></div>
                    <a class='face' href='#projects'>Check my builds</a>
                </div>
                <div class='btn-wrap'>
                    <div class='shadow'></div>
                    <a class='face' href='#' data-contact>Let's build together</a>
                </div>
            </div>
            <div class='flex flex-col items-start gap-2 border-[3px] border-(--color-black) rounded-(--radius-lg) p-4'>
                <ul class='gap-2'>
                    <li class='hero-label'>What I build</li>
                    <li class='tag'>Distributed Systems</li>
                    <li class='tag'>AI</li>
                </ul>
                <ul class='gap-2'>
                    <li class='tag'>Backends</li>
                    <li class='tag'>Automation</li>
                    <li class='tag'>Payments</li>
                </ul>
            </div>
        </div>
        <div class='flex flex-col items-center gap-4 self-stretch md:col-start-1 md:row-start-1'>
            <img src='/mi-gif.gif' alt='Renzo Tincopa' class='rounded-lg w-56 md:w-full md:max-w-md md:self-end aspect-square object-cover'> 
            <div class='has-dots socials-grid gap-4 mt-auto md:self-end md:w-full md:max-w-md'>
                <SocialIcon name='github' url='https://github.com/TincoNomad' class='badge' size={28} />
                <SocialIcon name='linkedin' url='https://www.linkedin.com/in/tinconomad/' class='badge' size={28} />
                <SocialIcon name='instagram' url='https://www.instagram.com/tinconomad/' class='badge instagram' size={28} />
                <SocialIcon name='bluesky' url='https://bsky.app/profile/wiracocha-labs.bsky.social' class='badge' size={28} />
                <SocialIcon name='mastodon' url='https://mastodon.social/@TincoNomad' class='badge' size={28} />
                <SocialIcon name='tiktok' url='https://www.tiktok.com/@tinconomad' class='badge' size={28} />
            </div>
        </div>
    </div>
    <img id='cottage' src="/hero.webp" alt="" class='absolute bottom-0 right-[5%] w-[202px] md:w-[clamp(414px,28.8vw,570px)] opacity-90 pointer-events-none z-0'>
</section>
