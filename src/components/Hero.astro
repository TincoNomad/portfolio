---
import SocialIcon from './SocialIcon.astro';
---

<section class='min-h-screen scroll-mt-20' id='home'>
    <div class='grid md:grid-cols-[1fr_2fr] items-center w-full md:max-w-5xl md:mx-auto mb-30 gap-8'>
        <div class='flex flex-col items-start gap-4 md:col-start-2 md:row-start-1'>
            <h1>Renzo Tincopa</h1>
            <h2> Backend Blacksmith/AI Automations</h2>
            <ul class='gap-2'>
                <li class='tag'>Backends</li>
                <li class='tag'>Automation</li>
                <li class='tag'>Payments</li>
                <li class='tag'>AI</li>
                <li class='tag'>Distributed Systems</li>
            </ul>
            <div class='btn-wrap'>
                <div class='shadow'></div>
                <a class='face' href='#projects'>See my work</a>
            </div>
        </div>
        <div class='flex justify-center md:col-start-1 md:row-start-1'>
            <img src='/mi-gif.gif' alt='Renzo Tincopa' class='rounded-lg w-48 md:w-80 aspect-square object-cover'>
        </div>
        <div class='flex justify-center md:col-start-1 md:row-start-2'>
            <div class='flex flex-wrap justify-center gap-4'>
                <SocialIcon name='github' url='https://github.com/tinconomad' class='badge' size={20} />
                <SocialIcon name='linkedin' url='#' class='badge' size={20} />
                <SocialIcon name='instagram' url='#' class='badge instagram' size={20} />
                <SocialIcon name='mastodon' url='#' class='badge' size={20} />
                <SocialIcon name='twitter' url='#' class='badge' size={20} />
                <SocialIcon name='tiktok' url='#' class='badge' size={20} /> 
            </div>
        </div>
        <div class='flex flex-col items-end md:col-start-2 md:row-start-2'>
            <h3 class="bubble !text-lg relative z-10 text-end">You tell me what you're trying to achieve.<br/>I design the system and build it</h3>
            <img id='cottage' src="/hero.webp" alt="" class='relative z-10 w-3/5'> 
        </div>
    </div>
</section>
