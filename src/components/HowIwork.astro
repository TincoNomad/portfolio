---
import { useTranslations } from '../i18n/utils';
import { howIWork } from '../i18n/content';
import type { Lang } from '../i18n/ui';

const lang = Astro.currentLocale as Lang ?? 'en';
const t = useTranslations(lang);
---

<section class='min-h-[1000px] mb-[-40px] min-[769px]:mb-[-100px] relative z-10 md:justify-start! bg-[url("/fondo_howIwork.webp")] bg-no-repeat bg-bottom bg-[length:100%_auto]'>
    <div class='w-full max-w-6xl mx-auto'>
        <h2 class='has-dots mb-0 w-fit'>{t('how.title')}</h2>
        <div class='flex gap-4 h-50%'>
            <div class='flex flex-col items-start relative'>
                <p class='bubble relative z-10 whitespace-pre-line'>
                {howIWork[lang]}
                </p>
                <img src='/howiwork.webp' alt='Renzo Tincopa' class='ms-4 hero-image relative z-0 -mt-[10px]'>
            </div>
        </div>
    </div>
</section>
