---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const lang = Astro.currentLocale as Lang ?? 'en';
const t = useTranslations(lang);
---

<div class='not-found'>
    <h1 class='not-found-code has-dots text-center'>{t('404.title')}</h1>

    <p class='bubble bubble-shadow-right text-center'>
        {t('404.text')}
    </p>

    <div class='btn-wrap'>
        <div class='shadow'></div>
        <a class='face' href={getRelativeLocaleUrl(lang, '/')}>{t('404.home')}</a>
    </div>
</div>

<style>
    .not-found {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
    }

    /* El contorno negro de 10px del h1 global solo funciona a tamaño display */
    .not-found-code {
        font-size: clamp(4rem, 16vw, 9rem);
        line-height: 1;
    }
</style>
