---
import ProjectsItem from './ProjectsItem.astro'
import { useTranslations } from '../i18n/utils';
import { projects } from '../i18n/content';
import type { Lang } from '../i18n/ui';

const lang = Astro.currentLocale as Lang ?? 'en';
const t = useTranslations(lang);
const FEATURED_PROJECTS = projects[lang];
---

<section id='projects' class='scroll-mt-30'>
  <div class='w-full max-w-6xl mx-auto'>
    <h2 class='has-dots items-start w-fit'>{t('projects.title')}</h2>
    <div class='projects-grid'>
      {FEATURED_PROJECTS.map(project => (
        <ProjectsItem {...project} />
      ))}
    </div>
    <div class='flex flex-col items-end my-4 relative'>
        <p class='bubble bubble-tail-right relative z-10 more-links' set:html={t('projects.more').replace('[GitHub]', `<a class='badge' href='https://github.com/TincoNomad' target='blank'>GitHub</a>`).replace('[Wiracocha Labs]', `<a class='badge' href='https://github.com/wiracocha-labs' target='blank'>Wiracocha Labs</a>`)} />
        <img src="/projects.webp" alt="Renzo Tincopa" class='hero-image relative z-0 -mt-[10px] me-4'>
    </div>
    <div class='flex justify-center my-4'>
        <div class='btn-wrap'>
            <div class='shadow'></div>
            <a class='face text-[clamp(2rem,5vw,3rem)]! px-[clamp(0.625rem,1.875vw,0.9375rem)]! py-[clamp(0.3125rem,1vw,0.46875rem)]!' href='#' data-contact>{t('header.cta')}</a>
        </div>
    </div>
  </div>
</section>
