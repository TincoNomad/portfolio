---
interface Props{
title: string;
description: string;
tags: string[];
link?: string;
github?: string;
image: string;
tree?: string;
}

const {title, description, tags, link, github, image, tree} = Astro.props;
---

<article class="bubble-wrap" data-tags={tags.join(',')}>
  <div class="dots-bg"></div>
  <div class="bubble bubble--card bubble--right">
    <h3>{title}</h3>
    <p>{description}</p>
    <ul class='gap-2 my-4'>
      {tags.map(tag=>(<li class='tag'>{tag}</li>))}
    </ul>
    <div class='flex gap-4'>
      {link && <a class='badge' href={link} target='blank'>More</a>}
      {github && <a class='badge' href={github} target='blank'>GitHub</a>}
    </div>
    <div class='project-media'>
      <img src={image} alt={`Screenshot of ${title}`}>
      {tree && <img src={tree} alt={`File tree of ${title}`}>}
    </div>
  </div>
</article>

