---

<section class='h-screen bg-[url("/fondo_reviews.webp")] bg-no-repeat bg-cover reviews-fade !flex !justify-start'>
    <div class='w-full'>
        <div class='w-full'>
            <h2 class='has-dots items-start mb-0'>Reviews</h2>
        </div>
        <div class='reviews-grid'>
            {REVIEWS.map(review => (
                <ReviewsItem {...review} />
            ))}
        </div>
    </div>
</section>
