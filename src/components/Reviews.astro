---
import ReviewsItem from './ReviewsItem.astro'

const REVIEWS = [
  {
    name: 'Jonathan Nolasco Barrientos',
    role: 'Head of Engineering / AI Engineer',
    text: "Renzo is an excellent professional with a particular ability to go beyond product development and put himself on the user's side — spotting opportunities for improvement and turning them into technical proposals. We worked together on frontend, backend, and blockchain development. I'd definitely recommend him if you want to push forward a challenging software project full of uncertainty.",
    linkedin: 'https://www.linkedin.com/in/jnolascob/',
  },
  {
    name: 'Luis Francisco Montero',
    role: 'Deep Conceptual Thinker / Systemic Strategist',
    text: 'Renzo is not only a great worker with amazing skills like: transparency, trust, courage and curiosity but also a great sense of humor and amiability. Always is a pleasure working with Renzo.',
    linkedin: 'https://www.linkedin.com/in/luisframontero/',
  },
  {
    name: 'William Whittle Jr.',
    role: 'International Entrepreneur / Sales Expert',
    text: "Crossing paths with Renzo in every day life would have been enough, but the fact that I was able to work with him in a professional setting was an absolute pleasure. He adds so much tangible and intangible value in everything he's involved in and always exceeds expectations while constantly learning new things. His stories are inspiring and his character and values are genuine. I look forward to the next time we work together in the future.",
    linkedin: 'https://www.linkedin.com/in/williamwhittle/',
  },
  {
    name: 'Robin Gerlach',
    role: 'Real Estate Agent, Denver/Boulder',
    text: "Renzo always shows up to work with a smile and tons of ideas for improving whatever space he's in. He radiates good energy and makes a positive change in the lives of his colleagues. I highly recommend Renzo for any project he takes on.",
    linkedin: 'https://www.linkedin.com/in/robin-gerlach/',
  },
];
---

<section id='reviews' class='md:scroll-mt-20 min-h-[100dvh] reviews-scene reviews-fade !flex md:justify-start!'>
    <div class='w-full max-w-6xl mx-auto'>
        <h2 class='has-dots items-start mb-0 w-fit'>Reviews</h2>
        <div class='reviews-carousel'>
            <div class='reviews-viewport'>
                <div class='reviews-track'>
                    {REVIEWS.map(review => (
                        <ReviewsItem {...review} />
                    ))}
                </div>
            </div>
            <button type="button" class='carousel-btn prev' aria-label='Review anterior'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class='carousel-btn next' aria-label='Review siguiente'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </button>
        </div>
    </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('.reviews-track');
  const prevBtn = document.querySelector<HTMLButtonElement>('.carousel-btn.prev');
  const nextBtn = document.querySelector<HTMLButtonElement>('.carousel-btn.next');

  if (track) {
    // Loop infinito: clona sets de tarjetas hasta cubrir viewport + una vuelta
    const originals = [...track.children];
    const count = originals.length;
    const cloneSet = () =>
      originals.forEach((el) => {
        const clone = el.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.querySelectorAll('a').forEach((a) => (a.tabIndex = -1));
        track.appendChild(clone);
      });

    let lw = 0; // ancho de una vuelta
    const measure = () => {
      const copy = track.children[count] as HTMLElement | undefined;
      lw = copy ? copy.offsetLeft - (track.children[0] as HTMLElement).offsetLeft : 0;
    };

    const viewport = track.parentElement as HTMLElement;
    do {
      cloneSet();
      measure();
    } while (
      lw > 0 &&
      track.children.length < count * 5 &&
      (track.children.length / count - 1) * lw < viewport.clientWidth
    );
    window.addEventListener('resize', measure);

    let pos = 0;
    const apply = () => {
      if (lw) pos = ((pos % lw) + lw) % lw;
      track.style.transform = `translateX(${-pos}px)`;
    };

    const step = () =>
      (track.children[0] as HTMLElement).offsetWidth +
      (parseFloat(getComputedStyle(track).gap) || 0);

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Los botones acumulan distancia que el tick anima con easing
    let tween = 0;
    const nudge = (dir: number) => {
      tween += dir * step();
      if (reduced) {
        pos += tween;
        tween = 0;
        apply();
      }
    };
    prevBtn?.addEventListener('click', () => nudge(-1));
    nextBtn?.addEventListener('click', () => nudge(1));

    let paused = false;
    let dragging = false;
    let startX = 0;
    let startPos = 0;

    track.addEventListener('pointerenter', () => (paused = true));
    track.addEventListener('pointerleave', () => (paused = false));
    track.addEventListener('pointerdown', (e) => {
      dragging = true;
      tween = 0;
      startX = e.clientX;
      startPos = pos;
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      pos = startPos - (e.clientX - startX);
      apply();
    });
    ['pointerup', 'pointercancel'].forEach((ev) =>
      track.addEventListener(ev, () => (dragging = false)),
    );

    if (!reduced) {
      const SPEED = 0.4;
      const tick = () => {
        if (!paused && !dragging) {
          if (Math.abs(tween) > 0.5) {
            pos += tween * 0.14;
            tween *= 0.86;
          } else {
            pos += tween + SPEED;
            tween = 0;
          }
          apply();
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
