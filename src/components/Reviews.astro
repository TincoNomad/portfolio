---
import ReviewsItem from './ReviewsItem.astro'
import { useTranslations } from '../i18n/utils';
import { reviews } from '../i18n/content';
import type { Lang } from '../i18n/ui';

const lang = Astro.currentLocale as Lang ?? 'en';
const t = useTranslations(lang);
const REVIEWS = reviews[lang];
---

<section id='reviews' class='md:scroll-mt-20 min-h-[100dvh] reviews-scene reviews-fade !flex md:justify-start!'>
    <div class='w-full max-w-6xl mx-auto'>
        <h2 class='has-dots items-start mb-0 w-fit'>{t('reviews.title')}</h2>
        <div class='reviews-carousel'>
            <div class='reviews-viewport'>
                <div class='reviews-track'>
                    {REVIEWS.map(review => (
                        <ReviewsItem {...review} />
                    ))}
                </div>
            </div>
            <button type="button" class='carousel-btn prev' aria-label={t('reviews.prev')}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class='carousel-btn next' aria-label={t('reviews.next')}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </button>
        </div>
    </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('.reviews-track');
  const prevBtn = document.querySelector<HTMLButtonElement>('.carousel-btn.prev');
  const nextBtn = document.querySelector<HTMLButtonElement>('.carousel-btn.next');

  if (track) {
    // Loop infinito: clona sets de tarjetas hasta cubrir viewport + una vuelta
    const originals = [...track.children];
    const count = originals.length;
    const cloneSet = () =>
      originals.forEach((el) => {
        const clone = el.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.querySelectorAll('a').forEach((a) => (a.tabIndex = -1));
        track.appendChild(clone);
      });

    let lw = 0; // ancho de una vuelta
    const measure = () => {
      const copy = track.children[count] as HTMLElement | undefined;
      lw = copy ? copy.offsetLeft - (track.children[0] as HTMLElement).offsetLeft : 0;
    };

    const viewport = track.parentElement as HTMLElement;
    do {
      cloneSet();
      measure();
    } while (
      lw > 0 &&
      track.children.length < count * 5 &&
      (track.children.length / count - 1) * lw < viewport.clientWidth
    );
    window.addEventListener('resize', measure);

    let pos = 0;
    const apply = () => {
      if (lw) pos = ((pos % lw) + lw) % lw;
      track.style.transform = `translateX(${-pos}px)`;
    };

    const step = () =>
      (track.children[0] as HTMLElement).offsetWidth +
      (parseFloat(getComputedStyle(track).gap) || 0);

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Los botones acumulan distancia que el tick anima con easing
    let tween = 0;
    const nudge = (dir: number) => {
      tween += dir * step();
      if (reduced) {
        pos += tween;
        tween = 0;
        apply();
      }
    };
    prevBtn?.addEventListener('click', () => nudge(-1));
    nextBtn?.addEventListener('click', () => nudge(1));

    let paused = false;
    let dragging = false;
    let startX = 0;
    let startPos = 0;

    track.addEventListener('pointerenter', () => (paused = true));
    track.addEventListener('pointerleave', () => (paused = false));
    track.addEventListener('pointerdown', (e) => {
      dragging = true;
      tween = 0;
      startX = e.clientX;
      startPos = pos;
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      pos = startPos - (e.clientX - startX);
      apply();
    });
    ['pointerup', 'pointercancel'].forEach((ev) =>
      track.addEventListener(ev, () => (dragging = false)),
    );

    if (!reduced) {
      const SPEED = 0.4;
      const tick = () => {
        if (!paused && !dragging) {
          if (Math.abs(tween) > 0.5) {
            pos += tween * 0.14;
            tween *= 0.86;
          } else {
            pos += tween + SPEED;
            tween = 0;
          }
          apply();
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
