---
import Icon from './Icon.astro';

interface Props {
  name: string;
  url: string;
  size?: number;
  class?: string;
}

const { name, url, size = 20, class: className } = Astro.props;
---

<a href={url} class={`inline-flex ${className ?? ''}`.trim()} target="_blank" rel="noopener noreferrer">
  <Icon name={name} size={size} />
</a>
