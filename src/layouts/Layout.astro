---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ContactModal from '../components/ContactModal.astro'
import '../styles/index.css'
import '../styles/responsive.css'

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Renzo Tincopa — Backend Blacksmith',
	description = "Backend engineer building automation, payments, AI and distributed systems. Tell me what you're trying to achieve — I design the system and build it.",
} = Astro.props;

const personSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Renzo Tincopa',
	jobTitle: 'Backend Engineer & AI Automation',
	knowsAbout: ['Backend Development', 'Automation', 'Payments', 'AI', 'Distributed Systems'],
});
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<script type="application/ld+json" set:html={personSchema} />
	</head>
    <body>
        <main > 
            <!--div class='bg-[#1e3a8a] !w-full'-->
                <Header />
            <!--/div-->
                <slot />
            <Footer />
            <ContactModal />
		</main>
	</body>
</html>

<script>
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement | null)?.closest('[data-contact]');
    if (!trigger) return;
    e.preventDefault();
    const modal = document.querySelector<HTMLDialogElement>('#contact-modal');
    if (modal && !modal.open) modal.showModal();
  });
</script>
