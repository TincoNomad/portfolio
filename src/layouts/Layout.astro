---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ContactModal from '../components/ContactModal.astro'
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/index.css'
import '../styles/responsive.css'

interface Props {
	title?: string;
	description?: string;
	lang?: Lang;
	noindex?: boolean;
}

const currentLang = Astro.currentLocale as Lang ?? 'en';

const {
	title = 'Renzo Tincopa — Backend Blacksmith',
	description = "Backend engineer building automation, payments, AI and distributed systems. Tell me what you're trying to achieve — I design the system and build it.",
	lang = currentLang,
	noindex = false,
} = Astro.props;

const t = useTranslations(lang);

const personSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Renzo Tincopa',
	jobTitle: 'Backend Engineer & AI Automation',
	knowsAbout: ['Backend Development', 'Automation', 'Payments', 'AI', 'Distributed Systems'],
});
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<script type="application/ld+json" set:html={personSchema} />
	</head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
        <ContactModal />
	</body>
</html>

<script>
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement | null)?.closest('[data-contact]');
    if (!trigger) return;
    e.preventDefault();
    const modal = document.querySelector<HTMLDialogElement>('#contact-modal');
    if (modal && !modal.open) modal.showModal();
  });
</script>
