---
import Layout from '../layouts/Layout.astro';
import Clouds from '../components/Clouds.astro';
import NotFound from '../components/NotFound.astro';
---

<Layout
    lang='en'
    title='404 — Page not found · Renzo Tincopa'
    description='This page does not exist. Head back to the portfolio.'
>
    <div class='relative w-full bg-sunset min-h-dvh flex flex-col'>
        <Clouds perZone={3} />
        <section class='relative z-10 flex-1 justify-center py-16'>
            <NotFound />
        </section>
    </div>
    <div class='sunset-fade'></div>
</Layout>
