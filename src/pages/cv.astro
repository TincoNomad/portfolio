---
import '../styles/cv.css';
// El CV vive fuera del Layout a propósito: sin header, sin footer, sin nubes.
// Al imprimir tiene que salir una hoja limpia, y un ATS tiene que poder leerlo.
const title = 'Renzo Tincopa — CV';
const description =
  'Rust backend engineer. Backends, CLIs and developer tools, shipped.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <div class="actions no-print">
      <a class="btn" href="/cv.pdf" download>Download PDF</a>
      <a class="back" href="/">&larr; Back to the site</a>
    </div>

    <main>
      <header>
        <h1>Renzo Tincopa Barreto</h1>
        <p class="role">Rust backend engineer &middot; Remote &middot; UTC-5</p>
        <p class="contact">
          <a href="mailto:renzotincopa@icloud.com">renzotincopa@icloud.com</a>
          <span>&middot;</span>
          <a href="https://github.com/TincoNomad">github.com/TincoNomad</a>
          <span>&middot;</span>
          <a href="https://www.linkedin.com/in/tinconomad/">linkedin.com/in/tinconomad</a>
          <span>&middot;</span>
          <a href="https://wiracochalabs.com">wiracochalabs.com</a>
        </p>
      </header>

      <section>
        <h2>Summary</h2>
        <p>
          I write Rust backends, CLIs and developer tools, and I ship them: four
          projects published, one crate on crates.io, prebuilt binaries for
          macOS, Linux and Windows. Before Rust I shipped Django backends as a
          freelancer for years, which is where I learned that a system is done
          when a client can use it, not when it compiles.
        </p>
      </section>

      <section>
        <h2>Selected work</h2>

        <article class="item">
          <h3>
            yachay
            <a href="https://github.com/wiracocha-labs/yachay">github.com/wiracocha-labs/yachay</a>
          </h3>
          <p>
            Rust CLI that tells you which local AI model fits your hardware.
            Reads RAM, CPU and OS, then picks from a curated database of 15
            models. Prebuilt binaries for five platforms.
          </p>
        </article>

        <article class="item">
          <h3>
            actix-crud-admin
            <a href="https://crates.io/crates/actix-crud-admin">crates.io/crates/actix-crud-admin</a>
          </h3>
          <p>
            Library that generates CRUD admin panels for Actix-web 4 from a
            resource registry, with pluggable auth. Published with docs,
            integration tests and a Diesel example.
          </p>
        </article>

        <article class="item">
          <h3>
            pcurl
            <a href="https://github.com/TincoNomad/pretty-curl">github.com/TincoNomad/pretty-curl</a>
          </h3>
          <p>
            HTTP pretty-printer for the terminal: colored status, aligned
            headers, indented JSON. Also runs plain-text collections and an MCP
            client. Releases for five platforms.
          </p>
        </article>

        <article class="item">
          <h3>
            grafik
            <a href="https://github.com/TincoNomad/grafik">github.com/TincoNomad/grafik</a>
          </h3>
          <p>
            Renders HTML into PNG carousels and vertical video with Chrome and
            ffmpeg. No dependencies, no framework. Includes a pipeline that cuts
            a long recording into social clips.
          </p>
        </article>
      </section>

      <section>
        <h2>Professional experience</h2>

        <article class="item">
          <h3>Freelance &mdash; Backend developer</h3>
          <p class="meta">Remote &middot; Jan 2022 &ndash; Present</p>
          <ul>
            <li>
              Built and shipped a full-stack platform for a fitness studio: auth
              with encrypted credentials and WhatsApp/Twilio identity
              verification, hierarchical roles for schools and teachers, bulk
              class import from CSV, and content management from a custom Django
              admin.
            </li>
            <li>
              Delivered backend integrations (Meta, Google, OpenAI APIs),
              internal tooling and frontend work across clients.
            </li>
            <li>
              Since 2025 the primary stack is Rust: Actix-web, tokio, SQLx,
              SurrealDB.
            </li>
          </ul>
        </article>

        <article class="item">
          <h3>Coini &mdash; Blockchain developer</h3>
          <p class="meta">Remote &middot; Sep 2023 &ndash; Jun 2024</p>
          <ul>
            <li>
              Designed and integrated Solidity contracts, connecting on-chain
              logic with backend services.
            </li>
            <li>
              Turned customer requirements into technical work across the
              backend and blockchain layers.
            </li>
          </ul>
        </article>

        <article class="item">
          <h3>Platzi &mdash; Student Advocate</h3>
          <p class="meta">Remote &middot; Feb 2022 &ndash; Jul 2023</p>
          <ul>
            <li>
              Ran daily support for the student community across Discord, email
              and events.
            </li>
            <li>
              Built and led onboarding sessions, and turned community feedback
              into prioritised reports for the dev teams.
            </li>
          </ul>
        </article>
      </section>

      <section>
        <h2>Stack</h2>
        <p>
          Rust (Actix-web, tokio, SQLx, clap, libp2p) &middot; PostgreSQL
          &middot; SurrealDB &middot; Supabase. Python and Django for prior and
          current client work &middot; Docker &middot; GitHub Actions &middot;
          TypeScript when the frontend needs it.
        </p>
        <p class="meta">
          Integrations: Anthropic API, OpenAI API, MCP, Twilio, SendGrid, Google
          APIs.
        </p>
      </section>

      <section>
        <h2>Languages</h2>
        <p>
          Spanish (native) &middot; English (fluent) &middot; Portuguese (fluent)
          &middot; French (basic)
        </p>
      </section>
    </main>
  </body>
</html>
