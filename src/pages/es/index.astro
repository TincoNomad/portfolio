---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import ProjectsHome from '../../components/ProjectsHome.astro'
import HowIwork from '../../components/HowIwork.astro'
import Clouds from '../../components/Clouds.astro'
// import Blog from '../../components/Blog.astro'
import Reviews from '../../components/Reviews.astro'
---

<Layout
    title='Renzo Tincopa — Backend Blacksmith & AI Automation'
    description='Backend engineer construyendo automatización, pagos, IA y sistemas distribuidos. Cuéntame qué quieres lograr — diseño el sistema y lo construyo.'
>
    <div class='relative w-full bg-sunset'>
        <img src='/sol.webp' alt='' class='absolute bottom-0 left-1/2 -translate-x-[calc(50%_-_80px)] w-[clamp(150px,52.5vw,18rem)] min-[769px]:w-[clamp(200px,70vw,24rem)]'>
        <Clouds />
        <div class='relative z-10'>
            <Hero />
            <ProjectsHome />
            <HowIwork />
        </div>
    </div>
    <div class='w-full bg-stars'>
        <About />
        {/* <Blog /> */}
        <Reviews />
    </div>
</Layout>
